====
---- QUERY
# Simple broadcast join whose probe key (l_orderkey) comes straight from a single
# Iceberg scan with disjoint per-file key ranges -> filtered broadcast engages.
# Result must match the plain-broadcast oracle (tpch_parquet.lineitem_sorted, below).
select count(*)
from tpch_iceberg.lineitem_sorted l
join tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
---- RESULTS
6001215
---- TYPES
BIGINT
