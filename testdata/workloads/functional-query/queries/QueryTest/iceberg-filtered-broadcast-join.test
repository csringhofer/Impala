---- QUERY
# Shuffle join below the broadcast join repartitions lineitem by hash(l_orderkey):
# probe rows no longer match the files their host scanned. The structural gate must
# reject this (silent data loss otherwise). Result matches the parquet oracle.
select straight_join count(*)
from tpch_iceberg.lineitem_sorted l
join /*+shuffle*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
join /*+broadcast*/ tpch_parquet.customer c on o.o_custkey = c.c_custkey
where l.l_orderkey between 100 and 200000
---- RESULTS
