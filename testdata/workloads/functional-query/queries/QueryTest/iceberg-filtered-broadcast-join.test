---- QUERY
# Broadcast-then-broadcast chain: a lower BROADCAST INNER join (on l_returnflag)
# sits between the scan and the l_orderkey broadcast join. A broadcast join keeps
# probe rows on their host, so the single-scan invariant still holds and filtering
# must engage. Such chains are very common. Result matches the parquet oracle.
select straight_join count(*)
from tpch_iceberg.lineitem_sorted l
join /*+broadcast*/ (select distinct l_returnflag as rf from tpch_parquet.lineitem) d
  on l.l_returnflag = d.rf
join /*+broadcast*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
---- RESULTS
6001215
---- TYPES
BIGINT
====
---- QUERY
select straight_join count(*)
from tpch_parquet.lineitem_sorted l
join /*+broadcast*/ (select distinct l_returnflag as rf from tpch_parquet.lineitem) d
  on l.l_returnflag = d.rf
join /*+broadcast*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
---- RESULTS
6001215
---- TYPES
BIGINT
====
---- QUERY
# The l_orderkey build sink must be key-range filtered even with the lower broadcast
# join in between (the lower join's own build sink stays a plain broadcast).
set explain_level=3;
explain
select straight_join count(*)
from tpch_iceberg.lineitem_sorted l
join /*+broadcast*/ (select distinct l_returnflag as rf from tpch_parquet.lineitem) d
  on l.l_returnflag = d.rf
join /*+broadcast*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
---- RESULTS: VERIFY_IS_SUBSET
row_regex:.*BROADCAST \(key-range filtered\).*
---- TYPES
STRING
====
---- QUERY
# REMOTE runtime filter correctness. Two broadcast joins on the SAME key: the top
# FBCAST join builds a runtime filter from o2.o_orderkey that ALSO targets the o1
# scan, which lives in a different fragment (a REMOTE target). Under FBCAST each
# host only holds its key-range slice of the broadcast build, so each host's runtime
# filter is PARTIAL. The coordinator publishes a single instance's filter to remote
# targets (is_broadcast_join && has_remote_targets -> pending_count=1), so an
# unguarded partial would drop matching o1 rows. We force the scan to block for the
# filter so any mis-pruning is deterministic (not timing-dependent). Must match the
# plain-broadcast oracle below (6001215).
set runtime_filter_wait_time_ms=30000;
select straight_join count(*)
from tpch_iceberg.lineitem_sorted l
join /*+broadcast*/ tpch_parquet.orders o1 on l.l_orderkey = o1.o_orderkey
join /*+broadcast*/ tpch_parquet.orders o2 on l.l_orderkey = o2.o_orderkey
---- RESULTS
6001215
---- TYPES
BIGINT
====
---- QUERY
set runtime_filter_wait_time_ms=30000;
select straight_join count(*)
from tpch_parquet.lineitem_sorted l
join /*+broadcast*/ tpch_parquet.orders o1 on l.l_orderkey = o1.o_orderkey
join /*+broadcast*/ tpch_parquet.orders o2 on l.l_orderkey = o2.o_orderkey
---- RESULTS
6001215
---- TYPES
BIGINT
====
---- QUERY
# Same remote-filter shape, probe narrowed to file-1's key range. The hosts scanning
# the other two files get no probe rows, so their build partition -- and their
# runtime filter -- is EMPTY. Before the fix the coordinator could publish one of
# those empty partials to the remote o1 scan, dropping ALL o1 rows -> result 0.
# Must match the oracle (500291).
set runtime_filter_wait_time_ms=30000;
select straight_join count(*)
from tpch_iceberg.lineitem_sorted l
join /*+broadcast*/ tpch_parquet.orders o1 on l.l_orderkey = o1.o_orderkey
join /*+broadcast*/ tpch_parquet.orders o2 on l.l_orderkey = o2.o_orderkey
where l.l_orderkey between 1 and 500000
---- RESULTS
500291
---- TYPES
BIGINT
====
---- QUERY
set runtime_filter_wait_time_ms=30000;
select straight_join count(*)
from tpch_parquet.lineitem_sorted l
join /*+broadcast*/ tpch_parquet.orders o1 on l.l_orderkey = o1.o_orderkey
join /*+broadcast*/ tpch_parquet.orders o2 on l.l_orderkey = o2.o_orderkey
where l.l_orderkey between 1 and 500000
---- RESULTS
500291
---- TYPES
BIGINT
====
---- QUERY
# The FBCAST join builds a PARTIAL filter per host (each host holds only its key-range
# slice of the broadcast build). The filter has a LOCAL target (the l probe, sound with
# the host's own partial) and a REMOTE target (the o1 scan in another fragment). These
# are split into two filters: the local target stays on the primary broadcast filter,
# while the remote target is served by a sibling that is AGGREGATED across all backends
# (is_broadcast_join=false), so o1 receives the complete filter -- not one host's
# partial. Assert the remote filter on o1.o_orderkey is present (applied, not dropped);
# the forced-wait correctness cases above prove the aggregated filter is sound.
set explain_level=2;
explain
select straight_join count(*)
from tpch_iceberg.lineitem_sorted l
join /*+broadcast*/ tpch_parquet.orders o1 on l.l_orderkey = o1.o_orderkey
join /*+broadcast*/ tpch_parquet.orders o2 on l.l_orderkey = o2.o_orderkey
---- RESULTS: VERIFY_IS_SUBSET
row_regex:.*-> o1.o_orderkey.*
---- TYPES
STRING
====
---- QUERY
# Interleaved / non-contiguous per-host routing. tpch_iceberg.lineitem_scattered has
# SIX disjoint l_orderkey files (1M-key bands) spread over three hosts, so a host owns
# TWO files whose ranges are NOT contiguous (e.g. [2M,3M] + [5M,6M], gap [3M,5M]).
# The per-file sweep-line routes each build (orders) row only to the hosts whose files
# actually cover its key, so a row landing in a host's gap is not sent to it -- unlike
# the old per-host [min,max] merge, which would have shipped the whole [2M,6M] span to
# that host. Correctness is unaffected (result matches the full join, 6001215).
select straight_join count(*)
from tpch_iceberg.lineitem_scattered l
join /*+broadcast*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
---- RESULTS
6001215
---- TYPES
BIGINT
====
---- QUERY
# Probe range that straddles several file boundaries and gaps: every matching build
# row must still reach the host holding the covering file. Matches the parquet oracle.
select straight_join count(*)
from tpch_iceberg.lineitem_scattered l
join /*+broadcast*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
where l.l_orderkey between 2500000 and 5500000
---- RESULTS
3000230
---- TYPES
BIGINT
====
---- QUERY
select count(*)
from tpch_parquet.lineitem l
join tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
where l.l_orderkey between 2500000 and 5500000
---- RESULTS
3000230
---- TYPES
BIGINT
====
---- QUERY
# A disjunction that keeps only the two ends of the key space -- exactly the
# non-contiguous shape a single host can end up owning. No matching row may be dropped.
select straight_join count(*)
from tpch_iceberg.lineitem_scattered l
join /*+broadcast*/ tpch_parquet.orders o on l.l_orderkey = o.o_orderkey
where l.l_orderkey < 1500000 or l.l_orderkey > 4500000
---- RESULTS
3000206
---- TYPES
BIGINT
